# ParkFlow Parking Service - variables de entorno de ejemplo.
# Copia a .env para desarrollo local y reemplaza los valores según PostgreSQL.
# No guardes credenciales reales en archivos versionados.

PARKING_DB_HOST=localhost
PARKING_DB_PORT=5432
PARKING_DB_NAME=db_parking
PARKING_DB_USERNAME=parking_app
PARKING_DB_PASSWORD=replace_with_local_app_password

# Solo son necesarias al activar el perfil "migrate".
# Esta cuenta debe tener permisos DDL sobre db_parking; no uses parking_app.
PARKING_DB_MIGRATION_USERNAME=parking_migrator
PARKING_DB_MIGRATION_PASSWORD=replace_with_local_migration_password
